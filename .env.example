# Configuração do Ambiente
FLASK_ENV=development
FLASK_APP=run.py
DEBUG=True
PORT=5000
SECRET_KEY=your-secret-key-here

# Banco de Dados PostgreSQL (Containerizado)
# No docker-compose, o host é 'db'. Para execução local fora do Docker, use 'localhost'.
POSTGRES_USER=radarjud
POSTGRES_PASSWORD=your-postgres-password-here
POSTGRES_DB=radarjud
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://radarjud:your-postgres-password-here@db:5432/radarjud

# APIs Públicas Oficiais do Judiciário
# API Pública DataJud CNJ (Consulte a chave pública em https://datajud-wiki.cnj.jus.br/api-publica/acesso/)
DATAJUD_API_KEY=your-datajud-api-key-here
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# API Pública Comunica PJe (Diário de Justiça Eletrônico / Intimações)
COMUNICA_PJE_URL=https://comunicaapi.pje.jus.br/api/v1/comunicacao

# Portal da Transparência (CGU - CEIS / CNEP)
PORTAL_TRANSPARENCIA_API_KEY=your-cgu-api-key-here

# Proxy Anti-Geoblocking (Edge Serverless Function na Vercel fixada em São Paulo / gru1)
CNJ_PROXY_URL=https://seu-projeto.vercel.app/api/cnj-proxy
CNJ_FORCE_PROXY=false

# Configurações de Conectividade e Resiliência
REQUEST_TIMEOUT_SECONDS=20
MAX_PROCESSES_PER_QUERY=100
CACHE_EXPIRATION_HOURS=24

# Proxy Edge Vercel (CNJ / DataJud) e Integrações Externas
PROXY_SHARED_SECRET=
GEMINI_API_KEY=

# Monitoramento Contínuo, Fila Upstash Redis & Notificações (US-11)
REDIS_URL=
CRON_SECRET=
RESEND_API_KEY=
ALERT_FROM_EMAIL=alertas@radarjus.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
